{
  "name": "Vertice Urbano - Dark Blue",
  "dataColors": ["#60A5FA", "#93C5FD", "#64748B", "#FF6B6B", "#38BDF8", "#A5B4FC"],
  "background": "#1E293B",
  "foreground": "#E2E8F0",
  "tableAccent": "#60A5FA",
  "good": "#60A5FA",
  "neutral": "#64748B",
  "bad": "#FF6B6B",
  "textClasses": {
    "callout": { "color": "#F1F5F9" },
    "title": { "color": "#F1F5F9" },
    "header": { "color": "#E2E8F0" },
    "label": { "color": "#CBD5E1" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0F172A" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1E293B" } }, "transparency": 0 }],
        "title": [{ "fontColor": { "solid": { "color": "#F1F5F9" } } }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#F1F5F9" } },
          "backColor": { "solid": { "color": "#1E293B" } }
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#E2E8F0" } },
          "backColorPrimary": { "solid": { "color": "#1E293B" } },
          "fontColorSecondary": { "solid": { "color": "#E2E8F0" } },
          "backColorSecondary": { "solid": { "color": "#243247" } }
        }],
        "grid": [{
          "gridHorizontalColor": { "solid": { "color": "#334155" } },
          "gridVerticalColor": { "solid": { "color": "#334155" } },
          "outlineColor": { "solid": { "color": "#334155" } }
        }]
      }
    }
  }
}